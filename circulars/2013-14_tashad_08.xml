            </clause>
            <clause eId="art_6__para_4__subpara_a__cls_5">
              <num>5.</num>
              <content>
                <p>תחזוקת מערכות מכניות</p>
              </content>
            </clause>
            <clause eId="art_6__para_4__subpara_a__cls_6">
              <num>6.</num>
              <content>
                <p>מערכות מכונאות רכב</p>
              </content>
            </clause>
          </subparagraph>
        </paragraph>
